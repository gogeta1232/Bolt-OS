{
  "name": "bolt-discord-bot",
  "version": "1.0.0",
  "description": "A fast, dependable Discord moderation bot built with Sapphire and MongoDB.",
  "private": true,
  "license": "Elastic-2.0",
  "homepage": "https://github.com/gogeta1232/Bolt-OS#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gogeta1232/Bolt-OS.git"
  },
  "bugs": {
    "url": "https://github.com/gogeta1232/Bolt-OS/issues"
  },
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx watch src/index.ts",
    "dev:cluster": "tsx src/sharding/clusterManager.ts",
    "start": "node dist/index.js",
    "start:cluster": "node dist/sharding/clusterManager.js",
    "db:indexes": "tsx src/scripts/sync-indexes.ts",
    "docs:export": "tsx src/scripts/export-commands.ts",
    "docs:check": "tsx src/scripts/export-commands.ts --check",
    "lint": "eslint src tests *.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "validate": "npm run format:check && npm run check && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@sapphire/decorators": "6.2.0",
    "@sapphire/framework": "5.5.1",
    "@sapphire/pieces": "4.4.1",
    "discord-hybrid-sharding": "^3.0.1",
    "discord.js": "14.27.0",
    "express": "5.3.0",
    "fuse.js": "7.5.0",
    "helmet": "8.3.0",
    "mongoose": "9.11.1",
    "pino": "10.4.0",
    "pretty-ms": "^9.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/express": "5.0.6",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "^2.30.0",
    "globals": "^17.13.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "discord",
    "moderation",
    "sapphire",
    "typescript"
  ]
}
